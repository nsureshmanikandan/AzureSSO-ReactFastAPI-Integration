# Copy to .env and fill in with values from your App Registrations (see docs/).

# Your Entra ID (Azure AD) tenant ID - Azure Portal > Microsoft Entra ID > Overview > Tenant ID
AZURE_TENANT_ID=00000000-0000-0000-0000-000000000000

# The BACKEND API's own App Registration client ID (NOT the frontend SPA's).
# Azure Portal > App registrations > <your API app> > Overview > Application (client) ID
AZURE_API_CLIENT_ID=00000000-0000-0000-0000-000000000000

# Optional. Leave commented out to accept tokens whose "aud" claim equals
# "api://<AZURE_API_CLIENT_ID>" (the standard convention). If your API app's
# "Expose an API" > Application ID URI is something else - e.g. a custom SPN
# name like "https://<tenant>.onmicrosoft.com/<custom-name>" - set the EXACT
# value here, or every real token will fail audience validation even with
# the correct tenant/client ID. Check: Azure Portal > App registrations >
# <your API app> > Expose an API > Application ID URI.
# AZURE_API_AUDIENCE=https://<tenant>.onmicrosoft.com/<custom-spn-name>

# False for local dev (React -> FastAPI directly, no APIM in the path).
# True once APIM is in front and its validate-jwt policy is applied -
# the backend then trusts APIM's X-User-Id / X-User-Roles headers instead.
TRUST_APIM_HEADERS=False

# Comma-separated list is NOT used here - pydantic-settings reads this as a
# JSON-style list; simplest for local dev is to leave the default in config.py
# and override only if your React dev server runs on a different port.
# ALLOWED_ORIGINS=["http://localhost:5173"]
