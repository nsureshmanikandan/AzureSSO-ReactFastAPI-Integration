# Copy to .env.local and fill in with values from your SPA App Registration (see docs/).

# App registrations > <your SPA app> > Overview > Application (client) ID
VITE_AZURE_CLIENT_ID=00000000-0000-0000-0000-000000000000

# App registrations > <your SPA app> > Overview > Directory (tenant) ID
VITE_AZURE_TENANT_ID=00000000-0000-0000-0000-000000000000

# Must exactly match a Redirect URI on the SPA app registration
VITE_REDIRECT_URI=http://localhost:5173

# <Application-ID-URI>/access_as_user - the Application ID URI must be
# copied VERBATIM from the API App Registration's "Expose an API" blade
# (Step 2d in the setup guide). Do NOT assume it's "api://<client-id>" -
# some orgs configure a custom URI instead (e.g.
# "https://<tenant>.onmicrosoft.com/<custom-spn-name>/access_as_user").
# This value, backend/.env's AZURE_API_AUDIENCE, and apim's api-audience
# Named Value must all be built from that same Application ID URI.
VITE_API_SCOPE=api://00000000-0000-0000-0000-000000000000/access_as_user

# Where the FastAPI backend lives. Point this at your APIM gateway URL once
# that's wired up instead of calling FastAPI directly.
VITE_API_BASE_URL=http://localhost:8000
